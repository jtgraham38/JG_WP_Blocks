{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jg-blocks/media-flip-card",
  "version": "0.1.0",
  "title": "Media Flip Card",
  "keywords": [
    "card",
    "flip",
    "image",
    "media",
    "hover"
  ],
  "category": "widgets",
  "icon": {
    "src": "../../jg.png"
  },
  "description": "A card that shows an image and caption on the front, then flips to reveal nested block content.",
  "example": {},
  "attributes": {
    "mediaId": {
      "type": "number",
      "default": 0
    },
    "mediaUrl": {
      "type": "string",
      "default": ""
    },
    "mediaAlt": {
      "type": "string",
      "default": ""
    },
    "caption": {
      "type": "string",
      "default": ""
    },
    "height": {
      "type": "string",
      "default": "20rem"
    },
    "borderColor": {
      "type": "string"
    },
    "style": {
      "type": "object"
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true,
      "__experimentalSkipSerialization": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "width": true,
      "style": true,
      "__experimentalSkipSerialization": true,
      "__experimentalDefaultControls": {
        "color": true,
        "radius": true,
        "width": true,
        "style": true
      }
    },
    "border": {
      "color": true,
      "radius": true,
      "width": true,
      "style": true,
      "__experimentalSkipSerialization": true,
      "__experimentalDefaultControls": {
        "color": true,
        "radius": true,
        "width": true,
        "style": true
      }
    }
  },
  "textdomain": "jg-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}